#!/bin/sh
#
# Commits sample changes in a scratch repository, with pre-commit next to a fake lint-kotlin that turns "ugly" into
# "pretty", and checks what it refuses and what it commits: ./.githooks/pre-commit.test

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
source_hooks="$(cd "$(dirname "$0")" && pwd)"
failures=0

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
repo=$work/repo
mkdir -p "$work/hooks" "$repo/front"
cp "$source_hooks/pre-commit" "$work/hooks/pre-commit"
cat >"$work/hooks/lint-kotlin" <<EOF
#!/bin/sh
echo run >>"$work/lint-runs"
[ -f "$work/lint-fails" ] && exit 1
find . -name '*.kt' -type f | while IFS= read -r f; do
    sed 's/ugly/pretty/' "\$f" >"\$f.formatted"
    mv "\$f.formatted" "\$f"
done
EOF
chmod +x "$work/hooks/pre-commit" "$work/hooks/lint-kotlin"

git init -q "$repo"
git -C "$repo" config core.hooksPath "$work/hooks"
printf '{\n  "scripts": {\n    "build": "nuxt build"\n  },\n  "dependencies": {\n    "vue": "^3.5.0"\n  }\n}\n' >"$repo/front/package.json"
cp "$repo/front/package.json" "$repo/package.json"
echo '{}' >"$repo/front/package-lock.json"
echo '{}' >"$repo/package-lock.json"
dd if=/dev/zero of="$repo/data.bin" bs=1048576 count=4 2>/dev/null
git -C "$repo" add . && git -C "$repo" commit -q --no-verify -m init

commit() {
    rm -f "$work/lint-runs"
    if git -C "$repo" commit -q -m "$1" >"$work/output" 2>&1; then result=accepted; else result=refused; fi
}

same() {
    label=$1
    expected=$2
    actual=$3
    if [ "$actual" = "$expected" ]; then
        echo "ok    $label"
    else
        echo "FAIL  $label: expected '$expected', got '$actual'"
        failures=$((failures + 1))
    fi
}

check() {
    expected=$1
    label=$2
    commit "$label"
    same "$expected  $label" "$expected" "$result"
    git -C "$repo" reset -q --hard HEAD
}

lint_runs() {
    if [ -f "$work/lint-runs" ]; then wc -l <"$work/lint-runs" | tr -d ' '; else echo 0; fi
}

echo notes >"$repo/notes.md" && git -C "$repo" add notes.md
check accepted "a small file"

dd if=/dev/zero of="$repo/big.bin" bs=1048576 count=6 2>/dev/null && git -C "$repo" add big.bin
check refused "a file over 5 MB"

dd if=/dev/zero of="$repo/café.bin" bs=1048576 count=6 2>/dev/null && git -C "$repo" add café.bin
check refused "a file over 5 MB with a non-ASCII name"

git -C "$repo" mv data.bin moved.bin
dd if=/dev/zero bs=1048576 count=3 2>/dev/null >>"$repo/moved.bin" && git -C "$repo" add moved.bin
check refused "a renamed file grown over 5 MB"

sed -i.bak 's/\^3.5.0/^3.6.0/' "$repo/front/package.json" && rm "$repo/front/package.json.bak"
git -C "$repo" add front/package.json
check refused "a dependency bump without the lock file"

sed -i.bak 's/\^3.5.0/^3.6.0/' "$repo/package.json" && rm "$repo/package.json.bak"
git -C "$repo" add package.json
check refused "a dependency bump without the lock file, at the root"

sed -i.bak 's/\^3.5.0/^3.6.0/' "$repo/front/package.json" && rm "$repo/front/package.json.bak"
echo '{"lockfileVersion": 3}' >"$repo/front/package-lock.json"
git -C "$repo" add front
check accepted "a dependency bump with its lock file"

sed -i.bak 's/nuxt build/nuxt build --prerender/' "$repo/front/package.json" && rm "$repo/front/package.json.bak"
git -C "$repo" add front/package.json
check accepted "a script change without the lock file"

git -C "$repo" rm -q front/package.json
check accepted "a deleted package.json"

echo 'class Cellar(val ugly: String)' >"$repo/Cellar.kt" && git -C "$repo" add Cellar.kt
commit "a fully staged Kotlin file"
same "a fully staged Kotlin file is accepted" accepted "$result"
same "a fully staged Kotlin file is committed formatted" "class Cellar(val pretty: String)" "$(git -C "$repo" show HEAD:Cellar.kt)"

echo 'class Bottle(val ugly: Int)' >"$repo/Bottle.kt" && git -C "$repo" add Bottle.kt
echo '// draft' >>"$repo/Bottle.kt"
commit "a partly staged Kotlin file"
same "a partly staged Kotlin file is committed as staged" "class Bottle(val ugly: Int)" "$(git -C "$repo" show HEAD:Bottle.kt)"
same "a partly staged Kotlin file is formatted on disk" "class Bottle(val pretty: Int)
// draft" "$(cat "$repo/Bottle.kt")"
same "a partly staged Kotlin file is said to be left unstaged" \
    "pre-commit: Bottle.kt reformatted, left unstaged (it had other unstaged changes)" "$(cat "$work/output")"
git -C "$repo" checkout -q -- Bottle.kt

git -C "$repo" rm -q Cellar.kt
commit "a deleted Kotlin file"
same "a deleted Kotlin file is accepted" accepted "$result"
same "a deleted Kotlin file runs no lint" 0 "$(lint_runs)"

git -C "$repo" mv Bottle.kt Wine.kt
commit "a renamed Kotlin file"
same "a renamed Kotlin file is committed formatted" "class Bottle(val pretty: Int)" "$(git -C "$repo" show HEAD:Wine.kt)"

echo 'class Rack(val ugly: Int)' >"$repo/My Rack.kt" && git -C "$repo" add "My Rack.kt"
commit "a Kotlin file with a space in its name"
same "a Kotlin file with a space in its name is committed formatted" "class Rack(val pretty: Int)" \
    "$(git -C "$repo" show "HEAD:My Rack.kt")"

touch "$work/lint-fails"
echo 'class Cork(val ugly: Int)' >"$repo/Cork.kt" && git -C "$repo" add Cork.kt
check refused "a Kotlin file that lint-kotlin fails on"
rm "$work/lint-fails"

if [ "$failures" -ne 0 ]; then
    echo "$failures failing"
    exit 1
fi
