#!/bin/sh
#
# Enable once per clone: git config core.hooksPath .githooks
# Skip once: git push --no-verify (the master ruleset on GitHub still applies)

while read -r _ _ remote_ref _; do
    if [ "$remote_ref" = "refs/heads/master" ]; then
        echo "pre-push: master only changes through a pull request, push a branch and open one" >&2
        exit 1
    fi
done
