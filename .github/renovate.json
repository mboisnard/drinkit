{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:earlyMondays",
    ":timezone(Europe/Paris)",
    ":assignee(mboisnard)",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "labels": ["dependencies"],
  "commitMessagePrefix": "[VERSION-UPDATE]",
  "rebaseWhen": "conflicted",
  "pin": {
    "rebaseWhen": "conflicted"
  },
  "automergeStrategy": "rebase",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "area:security"]
  },
  "lockFileMaintenance": {
    "description": "A refresh pulls transitive versions without the 7-day delay, so it waits for approval",
    "dependencyDashboardApproval": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Testcontainers images, updated along with compose",
      "managerFilePatterns": ["/src/testFixtures/kotlin/.+\\.kt$/"],
      "matchStrings": ["IMAGE_NAME = \"(?<depName>[^:\"]+):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Supply chain: a release waits 7 days, security fixes do not",
      "matchUpdateTypes": ["major", "minor", "patch", "digest"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Some releases come undated (JDK, large Docker Hub images such as postgres), which would block them forever",
      "matchDatasources": ["docker", "java-version"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Test images keep plain tags: Testcontainers rejects image:tag@digest",
      "matchManagers": ["custom.regex"],
      "pinDigests": false
    },
    {
      "description": "Majors need code changes: open them from the Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "CI tooling merges itself once CI gate is green, in one pull request. Behind master, it is rebased: the ruleset merges only an up-to-date branch",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions",
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Same for a new digest of the same image tag",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "The image that validates this file releases several times a day. Its pull request runs the new image on this file before it merges itself",
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "matchCategories": ["java"],
      "addLabels": ["gradle"]
    },
    {
      "matchCategories": ["js"],
      "addLabels": ["javascript"]
    },
    {
      "matchCategories": ["ci"],
      "addLabels": ["github-action"]
    },
    {
      "matchDatasources": ["docker"],
      "addLabels": ["docker"]
    }
  ]
}
