#!/bin/sh
#
# Claude Code SessionStart hook: tells Claude where the session stands, at start, on resume and after a compaction:
# its branch and what it works on, how far it is ahead of master, its uncommitted work and the merged worktrees.

command -v jq >/dev/null 2>&1 || exit 0

cwd=$(jq -r '.cwd // empty')
root=$(git -C "${cwd:-.}" rev-parse --show-toplevel 2>/dev/null) || exit 0

branch=$(git -C "$root" branch --show-current)
prefix=${branch%%-*}
echo "DrinkIt session in $root, on ${branch:-a detached HEAD}."
case $prefix in
    pr) echo "The branch reviews pull request #${branch#pr-}: read it with gh pr view ${branch#pr-}." ;;
    '' | *[!0-9]*) echo "Not on an issue branch: an issue is worked with /implement-issue <number>, in a worktree of its own." ;;
    *) echo "The branch works on issue #$prefix: read it with gh issue view $prefix." ;;
esac

ahead=$(git -C "$root" rev-list --count origin/master..HEAD 2>/dev/null)
[ "${ahead:-0}" -gt 0 ] && echo "$ahead commits ahead of origin/master."

changes=$(git -C "$root" status --short | head -n 15)
[ -n "$changes" ] && printf 'Uncommitted changes:\n%s\n' "$changes"

# A rebase merge rewrites the commits, so a merged branch is one whose changes git cherry finds on master
merged_worktrees() {
    git -C "$root" worktree list --porcelain | while read -r key value; do
        case $key in
            worktree) path=$value ;;
            branch)
                branch=${value#refs/heads/}
                [ -n "$(git -C "$root" rev-list -n 1 "origin/master..$branch" 2>/dev/null)" ] || continue
                cherry=$(git -C "$root" cherry origin/master "$branch" 2>/dev/null) || continue
                case $cherry in *+*) continue ;; esac
                echo "  $path ($branch)"
                ;;
        esac
    done
}

merged=$(merged_worktrees)
[ -n "$merged" ] && printf 'Worktrees merged into origin/master, to clean up with /implement-issue <issue>:\n%s\n' "$merged"
exit 0
