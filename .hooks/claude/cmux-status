#!/bin/sh
#
# Claude Code hook: in cmux, names the tab after the issue and its step ("#382 judge", "#382 PR #450") and shows the
# judge's verdict and the pull request's CI gate as sidebar pills. Does nothing outside cmux, never blocks.

[ -n "$CMUX_SURFACE_ID" ] || exit 0
command -v cmux >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0

# A Bash command that exits non-zero, as gh pr checks does on a failing or pending check, comes as
# PostToolUseFailure, its output in .error.
event='' agent='' cwd='' command='' output='' verdict=''
eval "$(jq -r '@sh "event=\(.hook_event_name // "") agent=\(.agent_id // "") cwd=\(.cwd // "") command=\(.tool_input.command // "") output=\(.tool_response.stdout // .error // "") verdict=\(.last_assistant_message // "")"')"

pill() {
    cmux set-status "drinkit_$1" "$2" --color "$3" >/dev/null 2>&1
}

case $event in
    PostToolUse*) [ -n "$agent" ] && exit 0 ;;
esac

branch=$(git -C "${cwd:-.}" branch --show-current 2>/dev/null)
issue=${branch%%-*}
case $issue in
    '' | *[!0-9]*) exit 0 ;;
esac

cache=$(git -C "${cwd:-.}" rev-parse --path-format=absolute --git-path claude/cmux 2>/dev/null) && mkdir -p "$cache" || exit 0
step=$(cat "$cache/step-$issue" 2>/dev/null)

case $event:$command in
    PostToolUse*"gh pr create"*)
        pr=$(printf '%s\n' "$output" | grep -o 'pull/[0-9][0-9]*' | head -n 1 | cut -d / -f 2)
        [ -n "$pr" ] && step="PR #$pr" && printf '%s\n' "$step" >"$cache/step-$issue" && pill ci "CI running" "#ff9500"
        ;;
    PostToolUse*"gh pr checks"*)
        case $(printf '%s\n' "$output" | awk -F '\t' '$1 == "CI gate" { print $2 }' | tail -n 1) in
            pass) pill ci "CI green" "#34c759" ;;
            fail) pill ci "CI red" "#ff3b30" ;;
            pending) pill ci "CI running" "#ff9500" ;;
        esac
        ;;
    SubagentStart:*) pill judge "judging" "#ff9500" ;;
    SubagentStop:*)
        case $verdict in
            "VERDICT: OK"*) pill judge "judge OK" "#34c759" ;;
            "VERDICT: NEEDS_WORK"*) pill judge "judge: needs work" "#ff3b30" ;;
            *) cmux clear-status drinkit_judge >/dev/null 2>&1 ;;
        esac
        ;;
esac

title="#$issue ${step:-implement}"
[ "$event" = SubagentStart ] && title="#$issue judge"
shown=$cache/shown-$CMUX_SURFACE_ID
[ "$title" = "$(cat "$shown" 2>/dev/null)" ] && exit 0
cmux rename-tab ${CMUX_WORKSPACE_ID:+--workspace "$CMUX_WORKSPACE_ID"} --surface "$CMUX_SURFACE_ID" "$title" >/dev/null 2>&1 &&
    printf '%s\n' "$title" >"$shown"
exit 0
