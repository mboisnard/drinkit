#!/bin/sh
#
# Feeds edited files to detekt-after-edit with a fake lint-kotlin and checks when it runs and what Claude is shown:
# ./.hooks/claude/detekt-after-edit.test

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
hook="$(cd "$(dirname "$0")" && pwd)/detekt-after-edit"
failures=0

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export GIT_CEILING_DIRECTORIES="$work"
mkdir -p "$work/repo/.hooks/git" "$work/repo/src" "$work/no-lint/src" "$work/outside"
git init -q "$work/repo"
git init -q "$work/no-lint"
cat >"$work/repo/.hooks/git/lint-kotlin" <<EOF
#!/bin/sh
echo run >>"$work/runs"
if [ -f "$work/findings" ]; then
    echo "> Task :drinkit-domain:detekt"
    echo "w: file://\$PWD/src/Money.kt:10:18 Non-public primary constructor is exposed via the generated 'copy()' method"
    echo "e: \$PWD/src/Cellar.kt:12:5 Missing newline before the closing brace [Wrapping]"
    echo "BUILD FAILED"
    exit 1
fi
if [ -f "$work/crash" ]; then
    echo "FAILURE: Build failed with an exception."
    echo "* What went wrong:"
    echo "Could not resolve all files for configuration ':detekt'."
    exit 1
fi
EOF
chmod +x "$work/repo/.hooks/git/lint-kotlin"

check() {
    expected_exit=$1
    expected_runs=$2
    label=$3
    file=$4
    tool=${5:-Edit}
    rm -f "$work/runs"
    stderr=$(jq -n --arg tool "$tool" --arg file "$file" '{tool_name: $tool, tool_input: {file_path: $file}}' |
        "$hook" 2>&1 >>"$work/stdout")
    actual_exit=$?
    actual_runs=0
    [ -f "$work/runs" ] && actual_runs=$(grep -c run "$work/runs")
    if [ "$actual_exit" -eq "$expected_exit" ] && [ "$actual_runs" -eq "$expected_runs" ]; then
        echo "ok    $label"
    else
        echo "FAIL  $label: exit $actual_exit, lint ran $actual_runs times"
        failures=$((failures + 1))
    fi
}

shown() {
    label=$1
    expected=$2
    case $stderr in
        *"$expected"*) echo "ok    $label" ;;
        *)
            echo "FAIL  $label: expected '$expected' in: $stderr"
            failures=$((failures + 1))
            ;;
    esac
}

check 0 0 "a Markdown file is left alone" "$work/repo/README.md"
check 0 1 "a clean Kotlin file passes" "$work/repo/src/Cellar.kt"
check 0 1 "a Kotlin file written whole is linted" "$work/repo/src/Bottle.kt" Write
check 0 1 "a Gradle script is linted" "$work/repo/build.gradle.kts"
check 0 0 "a Kotlin file outside a repository is left alone" "$work/outside/Script.kt"
check 0 0 "a repository without lint-kotlin is left alone" "$work/no-lint/src/Cellar.kt"

touch "$work/findings"
check 2 1 "a detekt failure blocks" "$work/repo/src/Cellar.kt"
shown "the finding is shown to Claude" "Cellar.kt:12:5 Missing newline before the closing brace [Wrapping]"
case $stderr in
    *"Money.kt"*)
        echo "FAIL  a compiler warning is shown: $stderr"
        failures=$((failures + 1))
        ;;
    *) echo "ok    compiler warnings are left out" ;;
esac
rm "$work/findings"

touch "$work/crash"
check 2 1 "a build failure without findings blocks" "$work/repo/src/Cellar.kt"
shown "the end of the output is shown when there is no finding" "Could not resolve all files for configuration ':detekt'."
rm "$work/crash"

git -C "$work/repo" switch -q -c pr-451
check 0 0 "a pull request under review runs no build" "$work/repo/src/Cellar.kt"

if [ -s "$work/stdout" ]; then
    echo "FAIL  the hook printed to stdout: $(cat "$work/stdout")"
    failures=$((failures + 1))
else
    echo "ok    nothing is ever printed to stdout"
fi

if [ "$failures" -ne 0 ]; then
    echo "$failures failing"
    exit 1
fi
