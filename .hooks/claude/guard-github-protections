#!/bin/sh
#
# Claude Code PreToolUse hook on Bash: refuses a merge, a write to a ruleset, a branch protection or a push protection
# bypass, any way around pre-push, and asks before a write under .hooks/. It reads the command as text, not as a shell.

if ! command -v jq >/dev/null 2>&1; then
    echo "guard-github-protections: jq not found, GitHub protection writes go unchecked" >&2
    exit 0
fi

input=$(cat)
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')
mode=$(printf '%s' "$input" | jq -r '.permission_mode // empty')

found=$(printf '%s' "$input" | jq -r '.tool_input.command // empty' | GUARD_CWD=$cwd awk '
    BEGIN {
        SEPARATOR = "\001"
        OPENING = "\002"
        CLOSING = "\003"
        MARK = "[\001\002\003]"
        BLANK = "\004"
        NEWLINE = "\005"
        MERGE_MUTATION = "mergepullrequest|enablepullrequestautomerge|enqueuepullrequest"
        MUTATION = "(create|update|delete)(repositoryruleset|branchprotectionrule)|" MERGE_MUTATION
        MERGE = "pulls/[^[:space:]/]+/merge|" MERGE_MUTATION
        ENDPOINT = "repos/[^[:space:]/]+/[^[:space:]/]+/(rulesets|branches/[^[:space:]]+/protection|secret-scanning/push-protection-bypasses|pulls/[^[:space:]/]+/merge)"
        METHOD = "(-[a-z]*x|--method|--request)[[:space:]=]*"
        WRITE = METHOD "(post|put|patch|delete)"
        READ = METHOD "get|(^|[[:space:]])--get([[:space:]]|$)"
        SHORT_READ = "(^|[[:space:]])-G([[:space:]]|$)"
        SHORT_BODY = "(^|[[:space:]])(-[A-Za-z]*[dFT]|-f[^[:space:]]*=)"
        LONG_BODY = "(^|[[:space:]])(-f|--field|--raw-field|--input|--data[a-z-]*|--json|--form|--upload-file)([[:space:]=]|$)"
        REPO_FLAG = "([[:space:]]+(-r|--repo)([[:space:]]+|=)[^[:space:]]+)*"
        PR_MERGE = "^gh" REPO_FLAG "[[:space:]]+pr" REPO_FLAG "[[:space:]]+merge([[:space:]]|$)"
        PR_MERGE_HELP = "^gh" REPO_FLAG "[[:space:]]+pr" REPO_FLAG "[[:space:]]+merge[[:space:]]+(-h|--help)[[:space:]]*$"
        WRAPPER = "^([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*|env|command|exec|nohup|nice|time|sudo|xargs|eval|sh|bash|zsh|dash|ksh|if|elif|then|else|do|while|until|!|timeout)([[:space:]]+|$)"
        WRAPPER_VALUE = "^(nice:(-n|--adjustment)|timeout:(-[sk]|--signal|--kill-after)|xargs:(-[adEILnPsJRS]|--(arg-file|delimiter|eof|max-args|max-lines|max-procs|max-chars|process-slot-var))|env:(-[uCP]|--unset|--chdir)|sudo:-[ugCDhprtUTR]|exec:-a|time:-[fo])$"
        SHELL = "^(eval|sh|bash|zsh|dash|ksh)([[:space:]]|$)"
        SHELL_WORD = "(^|[[:space:]/|&;(])(sh|bash|zsh|dash|ksh)([[:space:]|&;)]|$)"
        GIT_OPTION = "^[[:space:]]+(-[Cc][[:space:]]+[^[:space:]]+|--(git-dir|work-tree|namespace|config-env|attr-source|shallow-file|super-prefix)[[:space:]]+[^[:space:]]+|--[a-z-]+(=[^[:space:]]+)?|-[A-Za-z])"
        HOOKS_PATH_READ = "^config([[:space:]]+(--local|--global|--system|--worktree|--show-origin|--show-scope|--get|get))*[[:space:]]+core\\.hookspath[[:space:]]*$"
        HOOKS_PATH_SET = "^config([[:space:]]+(--local|--global|--system|--worktree|set))*[[:space:]]+core\\.hookspath[[:space:]]+\\.hooks/git[[:space:]]*$"
        CONFIG_QUIET = "^(commit|log|show|diff|blame|shortlog)([[:space:]]|$)"
        HOOKS = "\\.hooks([^[:alnum:]_.-]|$)"
        UNDER_HOOKS = "(^|/)\\.hooks(/|$)"
        GIT_CONFIG_FILE = "(\\.git/((worktrees|modules)/.+/)?config(\\.worktree)?|(^|/)\\.?gitconfig|\\.config/git/config)$"
        NEUTRAL = "^(cd|for|fi|done|esac|[}]|export|unset|set|read|:)([[:space:]]|$)"
        READER = "^(cat|head|tail|grep|egrep|fgrep|ls|wc|diff|cmp|file|stat|du|realpath|readlink|basename|dirname|echo|printf|test|\\[|jq|shellcheck|bats|true|false|pwd|nl|cut|tr|column|od|hexdump|shasum|sha1sum|sha256sum|md5sum|md5)([[:space:]]|$)"
        GIT_READ = "^(status|diff|log|show|ls-files|ls-tree|grep|blame|cat-file|rev-parse|rev-list|merge-base|check-ignore|describe|shortlog|add|commit|push|fetch|branch|remote)([[:space:]]|$)"
        GIT_CONFIG_READ = "^config([[:space:]]+(get|list|-l|--[a-z-]+))*([[:space:]]+[^-[:space:]][^[:space:]]*)?[[:space:]]*$"
        GIT_RUNS = "[[:space:]](-c|--config-env|--exec-path)([[:space:]=]|$)"
        GIT_WRITES = "[[:space:]](--output|--open-files-in-pager|-O|--edit|--upload-pack|--receive-pack|--exec)"
        RUNNER = "(GIT_[A-Z_]*|GH_(BROWSER|EDITOR|PAGER)|BROWSER|PAGER|EDITOR|VISUAL|BASH_ENV|ENV)="
        RUNNER_VARIABLE = "(^|[[:space:]])" RUNNER
        SED_READ = "^sed([[:space:]]+-n)?[[:space:]]+[0-9$,;p]+([[:space:]]+[^-[:space:]][^[:space:]]*)*[[:space:]]*$"
        FIND_WRITES = "[[:space:]]-(delete|exec|execdir|ok|okdir|fprint|fprint0|fprintf|fls)([[:space:]]|$)"
        NPM_TESTS = "^npm[[:space:]]+(ci|cit|clean-install|clean-install-test|install-ci-test|test|t|run[[:space:]]+test|run-script[[:space:]]+test)([[:space:]]|$)"
        GH_READ = "^gh" REPO_FLAG "[[:space:]]+((pr|issue)" REPO_FLAG "[[:space:]]+(view|list|create|comment|edit|checks|diff|status)|api|search|ruleset|run[[:space:]]+(view|list|watch))([[:space:]]|$)"
        cwd = ENVIRON["GUARD_CWD"]
    }

    function deny(rule, command) {
        print rule "\t" shown(command)
        exit
    }

    function shown(text) {
        gsub(BLANK "|" NEWLINE, " ", text)
        return text
    }

    # Cuts the command into segments on ; && || and line ends, and segments into pieces on | & ( ) $( and backquotes,
    # outside quotes. Quote characters are dropped. A here-document body is skipped unless it can run a command.
    function scan(    c, next_char) {
        size = length(command_text)
        line_start = 1
        for (i = 1; i <= size; i++) {
            c = substr(command_text, i, 1)
            next_char = substr(command_text, i + 1, 1)
            if (quote == "\047") {
                if (c == "\047") quote = ""
                else current = current quoted(c)
            } else if (c == "\\") {
                if (next_char != "\n") current = current quoted(next_char)
                escaped = ++i
            } else if (c == "$" && next_char == "(") {
                open_paren(quote)
                i++
            } else if (quote == "\"") {
                in_double_quotes(c)
            } else if (c == "\047" || c == "\"") {
                quote = c
            } else if (c == "(") {
                open_paren("")
            } else if (c == ")") {
                close_paren()
            } else if ((c == "&" || c == "|") && next_char == c) {
                cut_segment()
                i++
            } else if (c == ";") {
                cut_segment()
            } else if ((c == "&" || c == "|") && !redirection(c, next_char)) {
                current = current SEPARATOR
            } else if (c == "`") {
                backquote()
            } else if (c == "\n") {
                end_line()
            } else {
                if (c == "<") start_heredoc()
                current = current c
            }
        }
        cut_segment()
    }

    # The & of 2>&1 and &>, and the | of >|, belong to a redirection. After an escaped > or <, they separate commands.
    function redirection(c, next_char,    previous) {
        previous = substr(command_text, i - 1, 1)
        if (i - 1 == escaped)
            return 0
        return previous == ">" || previous == "<" || (c == "&" && next_char == ">")
    }

    function in_double_quotes(c) {
        if (c == "\"") quote = ""
        else if (c == "`") backquote()
        else current = current quoted(c)
    }

    # A blank inside quotes or after a backslash belongs to the word, as it does for the shell.
    function quoted(c) {
        if (c == " " || c == "\t") return BLANK
        if (c == "\n") return NEWLINE
        return c
    }

    # The text of a script, a word with its blanks back.
    function unquoted(text) {
        gsub(BLANK, " ", text)
        gsub(NEWLINE, "\n", text)
        return text
    }

    function backquote() {
        in_backquote = !in_backquote
        current = current (in_backquote ? OPENING : CLOSING)
    }

    function open_paren(quote_outside) {
        outer_quote[++depth] = quote_outside
        quote = ""
        current = current OPENING
    }

    function close_paren() {
        if (depth > 0) quote = outer_quote[depth--]
        current = current CLOSING
    }

    function cut_segment() {
        if (current != "") segment[++segments] = current
        current = ""
    }

    function start_heredoc(    rest) {
        if (delimiter != "" || substr(command_text, i + 1, 1) != "<" || substr(command_text, i + 2, 1) == "<" || substr(command_text, i - 1, 1) == "<")
            return
        rest = substr(command_text, i + 2)
        strip_tabs = sub(/^-/, "", rest)
        sub(/^[ \t]+/, "", rest)
        match(rest, /^[^[:space:];&|<>()]*/)
        delimiter = substr(rest, 1, RLENGTH)
        quoted_delimiter = gsub(/["\047\\]/, "", delimiter)
    }

    # An unquoted delimiter leaves $( and backquotes live in the body: such a body is read as commands.
    function end_line(    opener, body_end) {
        cut_segment()
        opener = substr(command_text, line_start, i - line_start)
        if (delimiter != "" && opener !~ SHELL_WORD) {
            body_end = heredoc_end()
            if (quoted_delimiter || heredoc_body !~ /`|\$\(/) {
                heredoc_bodies = heredoc_bodies heredoc_body
                heredoc_opener = opener
                i = body_end
            }
        }
        delimiter = ""
        line_start = i + 1
    }

    function heredoc_end(    position, line, stop) {
        heredoc_body = ""
        position = i
        while (position < size) {
            stop = index(substr(command_text, position + 1), "\n")
            line = stop ? substr(command_text, position + 1, stop - 1) : substr(command_text, position + 1)
            position += stop ? stop : size - position
            if (strip_tabs) sub(/^\t+/, "", line)
            if (line == delimiter) break
            heredoc_body = heredoc_body line "\n"
        }
        return position
    }

    function check_segment(text,    flat, lower, count, pieces, j) {
        flat = text
        gsub(MARK "|\n", " ", flat)
        sub(/^[[:space:]]+/, "", flat)
        lower = tolower(flat)
        if (lower ~ MUTATION || (lower ~ ENDPOINT && (lower ~ WRITE || (has_body(flat) && !is_read(flat)))))
            deny(lower ~ MERGE ? "merge" : "protection", flat)
        if (lower ~ /git_config_/ && lower ~ /hookspath/)
            deny("hooks-path", flat)
        if (lower ~ /graphql/ && lower ~ /(--input|[[:space:]=]@)/)
            deny("hidden-query", flat)
        if (flat ~ HOOKS)
            names_hooks = 1
        check_writes(text, flat)
        count = split(text, pieces, MARK)
        for (j = 1; j <= count; j++)
            check_piece(pieces[j], flat)
    }

    function has_body(flat) {
        return flat ~ SHORT_BODY || tolower(flat) ~ LONG_BODY
    }

    function is_read(flat) {
        return tolower(flat) ~ READ || flat ~ SHORT_READ
    }

    # The script of sh -c is scanned again, as check_simple says.
    function check_piece(piece, flat,    command) {
        command = command_of(piece)
        if (!via_shell)
            check_command(command, piece, flat)
    }

    # Strips the assignments and the wrappers, with their options and the values these take. A command run by xargs -I
    # may get any word from its input, so replaced records it.
    function command_of(text,    wrapper, option) {
        via_shell = 0
        replaced = 0
        assigned = ""
        sub(/^[[:space:]{!]+/, "", text)
        while (match(text, WRAPPER)) {
            wrapper = substr(text, 1, RLENGTH)
            text = substr(text, RLENGTH + 1)
            sub(/[[:space:]]+$/, "", wrapper)
            if (wrapper ~ SHELL) via_shell = 1
            if (wrapper ~ /=/) assigned = assigned " " wrapper
            while (match(text, /^-[^[:space:]]*([[:space:]]+|$)/)) {
                option = substr(text, 1, RLENGTH)
                text = substr(text, RLENGTH + 1)
                sub(/[[:space:]]+$/, "", option)
                if (wrapper ":" option ~ WRAPPER_VALUE) sub(/^[^[:space:]]*[[:space:]]*/, "", text)
                if (wrapper == "xargs" && option ~ /^(-[Ii]|--replace)/) replaced = 1
                if (wrapper == "env" && sub(/^(-[A-Za-z]*S|--split-string=?)/, "", option)) {
                    via_shell = 1
                    text = option " " text
                    break
                }
            }
            if (wrapper == "timeout") sub(/^[0-9.]+[smhd]?([[:space:]]+|$)/, "", text)
        }
        sub(/^\\/, "", text)
        return text
    }

    # Scans a script after the command around it, which reads it as one word.
    function rescan(script) {
        if (script ~ /^[[:space:]]*$/)
            return
        command_text = unquoted(script) "\n"
        quote = current = delimiter = ""
        depth = in_backquote = escaped = 0
        scan()
    }

    # The programs held by variables such as GIT_EXTERNAL_DIFF, one per line.
    function runner_values(text,    count, words, k, values) {
        count = split(text, words, /[[:space:]]+/)
        for (k = 1; k <= count; k++)
            if (words[k] ~ "^" RUNNER)
                values = values substr(words[k], index(words[k], "=") + 1) "\n"
        return values
    }

    function check_command(command, piece, flat,    lower, subcommand, config) {
        sub(/^[^[:space:]]*\//, "", command)
        lower = tolower(command)
        if (command ~ /^cd([[:space:]]|$)/) {
            cd_dir = joined(cd_dir, cd_target(command))
            return
        }
        if (lower ~ PR_MERGE && lower !~ PR_MERGE_HELP)
            deny("merge", flat)
        if (lower ~ /^gh[[:space:]]+alias[[:space:]]+(set|import)([[:space:]]|$)/)
            deny("alias", flat)
        if (lower !~ /^git([[:space:]]|$)/)
            return
        subcommand = git_subcommand(command)
        config = tolower(subcommand)
        if (config ~ HOOKS_PATH_SET && config ~ /[[:space:]]--(global|system)[[:space:]]/)
            deny("hooks-path-scope", flat)
        if ((lower ~ /core\.hookspath/ && config !~ HOOKS_PATH_READ && config !~ HOOKS_PATH_SET && !only_names_hooks_path(lower, config)) || tolower(piece) ~ /git_config_/)
            deny("hooks-path", flat)
        if (subcommand ~ /^push([[:space:]]|$)/) {
            if (subcommand ~ /[[:space:]]--no-v/)
                deny("no-verify", flat)
            push_dir[++pushes] = joined(cd_dir, git_dir)
            push_command[pushes] = flat
        }
    }

    # A subcommand that never changes the configuration may name core.hooksPath in its arguments, unless an option comes
    # before it, or xargs -I may replace a word of it.
    function only_names_hooks_path(lower, config) {
        return !replaced && config ~ CONFIG_QUIET && substr(lower, 1, length(lower) - length(config)) ~ /^git[[:space:]]+$/
    }

    # What a $( ), a ( ) or a backquote holds is a command of its own, the words after it belong to the one around it.
    function check_writes(text, flat,    k, c, level, buffer) {
        level = 0
        buffer[0] = ""
        for (k = 1; k <= length(text); k++) {
            c = substr(text, k, 1)
            if (c == OPENING) {
                buffer[++level] = ""
            } else if (c == CLOSING) {
                if (level > 0) check_simple(buffer[level--], flat)
            } else if (c == SEPARATOR) {
                check_simple(buffer[level], flat)
                buffer[level] = ""
            } else {
                buffer[level] = buffer[level] c
            }
        }
        while (level >= 0)
            check_simple(buffer[level--], flat)
    }

    # A shell without a script reads one from its input, which may write anywhere. The script of sh -c, and the program
    # a variable such as GIT_EXTERNAL_DIFF holds, set or exported, are scanned again as commands of their own.
    function check_simple(text, flat,    command, scripts) {
        command = command_of(text)
        scripts = runner_values(assigned " " (command ~ /^export[[:space:]]/ ? command : ""))
        if (!via_shell)
            check_program(command, flat)
        else if (command == "" && writer == "")
            writer = flat
        rescan(scripts (via_shell ? command : ""))
    }

    function check_program(command, flat,    under, write) {
        under = joined(cwd, cd_dir) ~ UNDER_HOOKS
        if (under)
            names_hooks = 1
        write = redirection_writes(command, under)
        if (write == 3 || (!reads(command) && names_git_config(command)))
            deny("git-config", flat)
        if (hooks_write == "" && write == 2)
            hooks_write = flat
        if (writer == "" && (write == 1 || !reads(command)))
            writer = flat
    }

    # A git configuration file can set core.hooksPath: only git config writes one, under the rules of check_command.
    function names_git_config(command,    count, words, k) {
        if (command ~ /^git[[:space:]]/ && tolower(git_subcommand(command)) ~ /^config([[:space:]]|$)/)
            return 0
        count = split(command, words, /[[:space:]]+/)
        for (k = 1; k <= count; k++) {
            sub(/^-[^=]*=/, "", words[k])
            if (git_config_file(words[k]))
                return 1
        }
        return 0
    }

    function git_config_file(path) {
        return path != "" && joined(joined(cwd, cd_dir), path) ~ GIT_CONFIG_FILE
    }

    # 3 for a redirection to a git configuration file, 2 for one under .hooks/, 1 for one whose target a variable builds,
    # 0 otherwise. >& word writes to the file word, unless word is a descriptor number or -.
    function redirection_writes(command, under,    target, variable) {
        variable = 0
        while (match(command, />[>|]?&?[[:space:]]*[^[:space:]]*/)) {
            target = substr(command, RSTART, RLENGTH)
            command = substr(command, RSTART + RLENGTH)
            sub(/^>[>|]?/, "", target)
            if (sub(/^&/, "", target) && target ~ /^[[:space:]]*([0-9]+|-)?$/)
                continue
            sub(/^[[:space:]]+/, "", target)
            if (target == "" || target == "/dev/null")
                continue
            if (git_config_file(target))
                return 3
            if (target ~ UNDER_HOOKS || (under && target !~ /^[\/~$]/))
                return 2
            if (target ~ /^\$/)
                variable = 1
        }
        return variable
    }

    # A program that only reads, or a hook run from .hooks/. Anything else may write, and so may a program that a
    # variable such as GIT_EDITOR lets git run, set for one command or exported.
    function reads(command,    program) {
        if (assigned ~ RUNNER_VARIABLE || (command ~ /^export[[:space:]]/ && command ~ RUNNER_VARIABLE))
            return 0
        if (command ~ /^[[:space:]]*$/ || command ~ NEUTRAL)
            return 1
        match(command, /^[^[:space:]]*/)
        program = substr(command, 1, RLENGTH)
        if (assigned == "" && program ~ UNDER_HOOKS && program !~ /(^|\/)\.\.(\/|$)/)
            return 1
        sub(/^[^[:space:]]*\//, "", command)
        if (command ~ READER)
            return 1
        if (command ~ /^sed([[:space:]]|$)/)
            return command ~ SED_READ
        if (command ~ /^find([[:space:]]|$)/)
            return command !~ FIND_WRITES
        if (command ~ /^sort([[:space:]]|$)/)
            return command !~ /[[:space:]](-[A-Za-z]*o|--output)/
        if (command ~ /^rg([[:space:]]|$)/)
            return command !~ /[[:space:]]--pre([[:space:]=]|$)/
        if (command ~ /^git([[:space:]]|$)/)
            return git_reads(command)
        if (command ~ /^npm[[:space:]]/) {
            gsub(/[[:space:]]--prefix([[:space:]]+|=)[^[:space:]]+/, "", command)
            return command ~ NPM_TESTS
        }
        if (command ~ /^npx[[:space:]]/)
            return command ~ /^npx([[:space:]]+-[^[:space:]]+)*[[:space:]]+bats([[:space:]]|$)/
        if (command ~ /^gh[[:space:]]/)
            return tolower(command) ~ GH_READ
        if (command ~ /^docker[[:space:]]+run[[:space:]]/)
            return read_only_mounts(command)
        return 0
    }

    # A -c or --exec-path before the subcommand can make git run any program.
    function git_reads(command,    subcommand, lower) {
        subcommand = git_subcommand(command)
        if (substr(command, 1, length(command) - length(subcommand)) ~ GIT_RUNS || subcommand ~ GIT_WRITES)
            return 0
        lower = tolower(subcommand)
        if (lower ~ /^config([[:space:]]|$)/)
            return lower ~ GIT_CONFIG_READ || lower ~ HOOKS_PATH_SET
        return lower ~ GIT_READ
    }

    function read_only_mounts(command,    volume) {
        if (command ~ /[[:space:]](--mount|--volumes-from)([[:space:]=]|$)/)
            return 0
        while (match(command, /[[:space:]](-[A-Za-z]*v|--volume)([[:space:]]+|=)?[^-[:space:]][^[:space:]]*/)) {
            volume = substr(command, RSTART, RLENGTH)
            command = substr(command, RSTART + RLENGTH)
            if (volume !~ /:ro(,[^[:space:]]*)?$/)
                return 0
        }
        return 1
    }

    function cd_target(command) {
        sub(/^cd([[:space:]]+-[LPe@]+)*[[:space:]]*/, "", command)
        if (command == "") return "~"
        match(command, /^[^[:space:]]+/)
        return substr(command, 1, RLENGTH)
    }

    function git_subcommand(text,    option) {
        git_dir = ""
        text = substr(text, 4)
        while (match(text, GIT_OPTION)) {
            option = substr(text, 1, RLENGTH)
            text = substr(text, RLENGTH + 1)
            sub(/^[[:space:]]+/, "", option)
            if (option ~ /^(-C[[:space:]]|--git-dir[[:space:]=]|--work-tree[[:space:]=])/) {
                sub(/^[^[:space:]=]+[[:space:]=]+/, "", option)
                git_dir = joined(git_dir, option)
            }
        }
        sub(/^[[:space:]]+/, "", text)
        return text
    }

    function joined(base, path) {
        if (path == "") return base
        if (base == "" || path ~ /^[\/~]/) return path
        return base "/" path
    }

    { command_text = command_text $0 "\n" }

    END {
        scan()
        if (tolower(heredoc_bodies) ~ MUTATION)
            deny(tolower(heredoc_bodies) ~ MERGE ? "merge" : "protection", heredoc_opener)
        if (heredoc_bodies ~ HOOKS)
            names_hooks = 1
        for (s = 1; s <= segments; s++)
            check_segment(segment[s])
        for (p = 1; p <= pushes; p++)
            print "push\t" shown(push_dir[p]) "\t" shown(push_command[p])
        if (hooks_write != "")
            print "ask\t" shown(hooks_write)
        else if (names_hooks && writer != "")
            print "ask\t" shown(writer)
    }')

[ -n "$found" ] || exit 0

answer() {
    case $2 in
        protection) reason="coding agents never change rulesets, branch protection or push protection bypasses. Ask the maintainer to run it" ;;
        merge) reason="coding agents never merge a pull request, the maintainer does. Leave it open for review" ;;
        hidden-query) reason="a GraphQL query read from a file or stdin cannot be checked. Pass it inline with -f query=..." ;;
        alias) reason="a gh alias can hide a merge. Run the gh command itself" ;;
        hooks-path) reason="the git hooks keep master safe, so core.hooksPath stays .hooks/git. Never override or unset it" ;;
        git-config) reason="a git configuration file can set core.hooksPath, which stays .hooks/git. Change a setting with git config" ;;
        hooks-path-scope) reason="core.hooksPath is set in each clone, never globally, where it would run the hooks of every repository. Run git config core.hooksPath .hooks/git in the clone" ;;
        no-verify) reason="pre-push keeps master safe. Push without --no-verify" ;;
        hooks-off) reason="the git hooks do not run in $4, then push again" ;;
        hooks-write) reason="this command may write under .hooks/, whose hooks keep master safe. Approve it only if you asked for this change" ;;
        hooks-write-unattended) reason="no one can approve a write under .hooks/ in bypassPermissions mode. Change a hook with the Edit tool, which asks the maintainer" ;;
    esac
    jq -n --arg decision "$1" --arg reason "$reason" --arg command "$3" '{
        hookSpecificOutput: {
            hookEventName: "PreToolUse",
            permissionDecision: $decision,
            permissionDecisionReason: ("guard-github-protections: " + $reason + ": " + $command)
        }
    }'
}

resolved() {
    case $1 in
        '') printf '%s' "${cwd:-.}" ;;
        \~) printf '%s' "$HOME" ;;
        \~/*) printf '%s/%s' "$HOME" "${1#\~/}" ;;
        /*) printf '%s' "$1" ;;
        *) printf '%s/%s' "${cwd:-.}" "$1" ;;
    esac
}

# Refuses the first push from a clone whose git hooks do not run.
refuse_push_without_hooks() {
    command -v git >/dev/null 2>&1 || return 0
    # shellcheck source=../lib/git-hooks.sh
    . "$(dirname "$0")/../lib/git-hooks.sh"
    printf '%s\n' "$found" | while IFS= read -r push; do
        case $push in
            push"$tab"*) push=${push#push"$tab"} ;;
            *) continue ;;
        esac
        dir=$(resolved "${push%%"$tab"*}")
        off=$(git_hooks_off "$dir")
        [ -n "$off" ] || continue
        answer deny hooks-off "${push#*"$tab"}" "$dir: $off"
        break
    done
}

tab=$(printf '\t')
rule=${found%%"$tab"*}
case $rule in
    push | ask) ;;
    *)
        answer deny "$rule" "${found#*"$tab"}"
        exit 0
        ;;
esac

refused=$(refuse_push_without_hooks)
if [ -n "$refused" ]; then
    printf '%s\n' "$refused"
    exit 0
fi

newline='
'
write=${found##*"$newline"}
case $write in
    ask"$tab"*) write=${write#ask"$tab"} ;;
    *) exit 0 ;;
esac
if [ "$mode" = bypassPermissions ]; then
    answer deny hooks-write-unattended "$write"
else
    answer ask hooks-write "$write"
fi
exit 0
