#!/bin/sh
#
# Claude Code hook on SessionStart and Stop: when a turn changed Kotlin or frontend sources, compiles or type checks
# them and hands the errors back to Claude. A state checked once, pass or fail, is never checked again: no loop.

command -v jq >/dev/null 2>&1 || exit 0

input=$(cat)
event=$(printf '%s' "$input" | jq -r '.hook_event_name // empty')
source=$(printf '%s' "$input" | jq -r '.source // empty')
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')

# cwd follows Claude's cd, which can leave the repository.
root=$(git -C "${cwd:-.}" rev-parse --show-toplevel 2>/dev/null)
if [ -z "$root" ] && [ -n "$CLAUDE_PROJECT_DIR" ]; then
    root=$(git -C "$CLAUDE_PROJECT_DIR" rev-parse --show-toplevel 2>/dev/null)
fi
[ -n "$root" ] || exit 0

# Only a new session starts from a clean slate: after a resume, a /clear or a compaction, the changes not checked yet
# still are. A pull request under review runs no build.
[ "$event" = SessionStart ] && [ "$source" != startup ] && exit 0
case $(git -C "$root" branch --show-current) in
    pr-*) exit 0 ;;
esac
state=$(git -C "$root" rev-parse --path-format=absolute --git-path claude) || exit 0
mkdir -p "$state" || exit 0

fingerprint() {
    (
        cd "$root" || exit
        git ls-files --stage -- "$@"
        git diff -- "$@"
        git ls-files -z --others --exclude-standard -- "$@" | xargs -0 cat
    ) | cksum
}

record() {
    printf '%s\n' "$2" >"$state/$1-checked"
}

# A worktree seen for the first time has nothing to check while it matches its commit.
needs_check() {
    kind=$1
    print=$2
    shift 2
    if [ ! -f "$state/$kind-checked" ] && [ -z "$(git -C "$root" status --porcelain -- "$@")" ]; then
        record "$kind" "$print"
        return 1
    fi
    [ "$(cat "$state/$kind-checked" 2>/dev/null)" != "$print" ]
}

compile_kotlin() {
    output=$(cd "$root" && ./gradlew compileTestKotlin --console=plain 2>&1) && return
    found=$(printf '%s\n' "$output" | grep '^e: ' | head -n 30)
    [ -n "$found" ] || found=$(printf '%s\n' "$output" | tail -n 30)
    printf 'The Kotlin code no longer compiles:\n%s\n' "$found"
}

type_check_app() {
    manifest=$1
    jq -e '.scripts.typecheck' "$root/$manifest" >/dev/null 2>&1 || return
    app=$(dirname "$root/$manifest")
    [ -d "$app/node_modules" ] || return
    output=$(cd "$app" && npm run --silent typecheck 2>&1 </dev/null) && return
    printf 'The type check of %s fails:\n%s\n' "$manifest" "$(printf '%s\n' "$output" | tail -n 30)"
}

type_check_frontend() {
    git -C "$root" ls-files -- '*package.json' | while IFS= read -r manifest; do
        type_check_app "$manifest"
    done
}

kotlin_print=$(fingerprint '*.kt' '*.kts')
typescript_print=$(fingerprint '*.vue' '*.ts')
if [ "$event" = SessionStart ]; then
    record kotlin "$kotlin_print"
    record typescript "$typescript_print"
    exit 0
fi

kotlin_errors=
if needs_check kotlin "$kotlin_print" '*.kt' '*.kts' && [ -x "$root/gradlew" ]; then
    kotlin_errors=$(compile_kotlin)
    record kotlin "$kotlin_print"
fi

typescript_errors=
if needs_check typescript "$typescript_print" '*.vue' '*.ts' && command -v npm >/dev/null 2>&1; then
    typescript_errors=$(type_check_frontend)
    record typescript "$typescript_print"
fi

[ -n "$kotlin_errors$typescript_errors" ] || exit 0
jq -n --arg kotlin "$kotlin_errors" --arg typescript "$typescript_errors" '{
    decision: "block",
    reason: (["compile-at-stop: fix this before you finish.", $kotlin, $typescript] | map(select(. != "")) | join("\n"))
}'
