#!/bin/sh
#
# Claude Code hook on SessionStart and Stop: when a turn changed Kotlin sources, compiles them and runs the architecture
# tests, or type checks changed frontend sources, and hands the errors back. A state is checked once: no loop.

command -v jq >/dev/null 2>&1 || exit 0

event='' source='' cwd=''
eval "$(jq -r '@sh "event=\(.hook_event_name // "") source=\(.source // "") cwd=\(.cwd // "")"')"

# cwd follows Claude's cd, which can leave the repository.
root=$(git -C "${cwd:-.}" rev-parse --show-toplevel 2>/dev/null)
[ -n "$root" ] || [ -z "$CLAUDE_PROJECT_DIR" ] || root=$(git -C "$CLAUDE_PROJECT_DIR" rev-parse --show-toplevel 2>/dev/null)
[ -n "$root" ] || exit 0

# Only a new session starts from a clean slate: after a resume, a /clear or a compaction, the changes not checked yet
# still are. A pull request under review runs no build.
[ "$event" = SessionStart ] && [ "$source" != startup ] && exit 0
case $(git -C "$root" branch --show-current) in
    pr-*) exit 0 ;;
esac
state=$(git -C "$root" rev-parse --path-format=absolute --git-path claude) && mkdir -p "$state" || exit 0

# Succeeds when the files of <patterns> changed since <kind> was last checked, their state in $print. A session start
# only records it, and so does a worktree seen for the first time, while it matches its commit.
needs_check() {
    kind=$1
    shift
    print=$(cd "$root" && {
        git ls-files --stage -- "$@"
        git diff -- "$@"
        git ls-files -z --others --exclude-standard -- "$@" | xargs -0 cat
    } | cksum)
    if [ "$event" = SessionStart ] || { [ ! -f "$state/$kind-checked" ] && [ -z "$(git -C "$root" status --porcelain -- "$@")" ]; }; then
        record "$kind"
        return 1
    fi
    [ "$(cat "$state/$kind-checked" 2>/dev/null)" != "$print" ]
}

record() {
    printf '%s\n' "$print" >"$state/$1-checked"
}

compile_kotlin() {
    set -- compileTestKotlin
    [ -f "$root/architecture-tests/build.gradle.kts" ] && set -- "$@" :architecture-tests:test
    output=$(cd "$root" && ./gradlew "$@" --console=plain 2>&1) && return
    found=$(printf '%s\n' "$output" | grep '^e: ' | head -n 30)
    [ -n "$found" ] && printf 'The Kotlin code no longer compiles:\n%s\n' "$found" && return
    # A broken rule prints its id, then its reason and fix on the next line, then each violation
    found=$(printf '%s\n' "$output" | awk '/ Rule: /{print; getline; print; next} /Message: |File: /' |
        sed 's/^ *//; s/^java.lang.AssertionError: //' | head -n 30)
    [ -n "$found" ] && printf 'An architecture rule is broken:\n%s\n' "$found" && return
    printf 'The Kotlin build fails:\n%s\n' "$(printf '%s\n' "$output" | tail -n 30)"
}

type_check_frontend() {
    git -C "$root" ls-files -- '*package.json' | while IFS= read -r manifest; do
        app=$(dirname "$root/$manifest")
        jq -e '.scripts.typecheck' "$root/$manifest" >/dev/null 2>&1 && [ -d "$app/node_modules" ] || continue
        output=$(cd "$app" && npm run --silent typecheck 2>&1 </dev/null) ||
            printf 'The type check of %s fails:\n%s\n' "$manifest" "$(printf '%s\n' "$output" | tail -n 30)"
    done
}

kotlin_errors=
if needs_check kotlin '*.kt' '*.kts' && [ -x "$root/gradlew" ]; then
    kotlin_errors=$(compile_kotlin)
    record kotlin
fi
typescript_errors=
if needs_check typescript '*.vue' '*.ts' && command -v npm >/dev/null 2>&1; then
    typescript_errors=$(type_check_frontend)
    record typescript
fi

[ -n "$kotlin_errors$typescript_errors" ] || exit 0
jq -n --arg kotlin "$kotlin_errors" --arg typescript "$typescript_errors" '{decision: "block",
    reason: (["compile-at-stop: fix this before you finish.", $kotlin, $typescript] | map(select(. != "")) | join("\n"))}'
