{
  "name": "drinkit-frontend",
  "description": "The Nuxt app of DrinkIt, rendered on the server.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "lint": "eslint --max-warnings 0 . && stylelint 'app/**/*.{css,vue}' --allow-empty-input",
    "lint:fix": "eslint --fix --max-warnings 0 . && stylelint --fix 'app/**/*.{css,vue}' --allow-empty-input",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:ui": "playwright test",
    "typecheck": "nuxt typecheck && tsc --project test/unit"
  },
  "dependencies": {
    "@drinkit/api-client-starter": "workspace:*",
    "@drinkit/i18n-starter": "workspace:*",
    "@drinkit/nuxt-starter": "workspace:*",
    "@drinkit/observability-starter": "workspace:*",
    "@drinkit/security-starter": "workspace:*",
    "@iconify-json/lucide": "catalog:",
    "@nuxt/ui": "catalog:",
    "nuxt": "catalog:",
    "ofetch": "catalog:",
    "tailwindcss": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@drinkit/eslint-config": "workspace:*",
    "@drinkit/stylelint-config": "workspace:*",
    "@drinkit/test-starter": "workspace:*",
    "@nuxt/test-utils": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/vue": "catalog:",
    "@types/node": "catalog:",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "msw": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:",
    "web-vitals": "catalog:"
  }
}
