{
  "name": "drinkit-docs",
  "description": "How Drink It, a cellar manager for wines and spirits, is built and why.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt generate",
    "dev": "nuxt dev",
    "lint": "eslint --max-warnings 0 . && stylelint 'app/**/*.{css,vue}' --allow-empty-input",
    "lint:fix": "eslint --fix --max-warnings 0 . && stylelint --fix 'app/**/*.{css,vue}' --allow-empty-input",
    "postinstall": "nuxt prepare",
    "preview": "pnpm dlx serve .output/public",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@barzhsieh/nuxt-content-mermaid": "catalog:",
    "@nuxt/content": "catalog:",
    "@nuxtjs/i18n": "catalog:",
    "docus": "catalog:",
    "nuxt": "catalog:",
    "scule": "catalog:"
  },
  "devDependencies": {
    "@drinkit/eslint-config": "workspace:*",
    "@drinkit/stylelint-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vue-tsc": "catalog:"
  }
}
