{
  "name": "@drinkit/nuxt-starter",
  "description": "The Nuxt layer every DrinkIt app and frontend tech starter builds on: explicit imports, the error page, the browsers it builds for and the shared hooks.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./problem-detail": "./app/problem-detail.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 . && stylelint 'app/**/*.{css,vue}' --allow-empty-input",
    "lint:fix": "eslint --fix --max-warnings 0 . && stylelint --fix 'app/**/*.{css,vue}' --allow-empty-input",
    "test": "vitest run",
    "typecheck": "nuxt typecheck && tsc --project test/unit",
    "postinstall": "nuxt prepare"
  },
  "devDependencies": {
    "@drinkit/eslint-config": "workspace:*",
    "@drinkit/stylelint-config": "workspace:*",
    "@drinkit/test-starter": "workspace:*",
    "@nuxt/test-utils": "catalog:",
    "@testing-library/vue": "catalog:",
    "@types/node": "catalog:",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "nuxt": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "nuxt": "catalog:"
  }
}
