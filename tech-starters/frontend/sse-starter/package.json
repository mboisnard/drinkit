{
  "name": "@drinkit/sse-starter",
  "description": "The Nuxt layer that receives the server-sent events of a DrinkIt backend on one connection per tab, held while a page listens and the tab is visible, and opened again on each sign-in.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./use-server-data": "./app/use-server-data.ts",
    "./use-server-event": "./app/use-server-event.ts",
    "./testing": "./testing/index.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix --max-warnings 0 .",
    "test": "vitest run",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@drinkit/api-client-starter": "workspace:*",
    "@drinkit/nuxt-starter": "workspace:*"
  },
  "devDependencies": {
    "@drinkit/eslint-config": "workspace:*",
    "@drinkit/i18n-starter": "workspace:*",
    "@drinkit/test-starter": "workspace:*",
    "@nuxt/test-utils": "catalog:",
    "@types/node": "catalog:",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "nuxt": "catalog:"
  }
}
