#!/bin/sh
#
# Claude Code PostToolUse hook on Write and Edit: once a Kotlin source or a Gradle script changes, runs lint-kotlin
# from its worktree and shows Claude the detekt findings when it fails.

command -v jq >/dev/null 2>&1 || exit 0

file=$(jq -r '.tool_input.file_path // empty')
case $file in
    *.kt | *.kts) ;;
    *) exit 0 ;;
esac

root=$(git -C "$(dirname "$file")" rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -x "$root/.githooks/lint-kotlin" ] || exit 0
case $(git -C "$root" branch --show-current) in
    pr-*) exit 0 ;;
esac

output=$(cd "$root" && ./.githooks/lint-kotlin 2>&1) && exit 0

findings=$(printf '%s\n' "$output" | grep '^e: ' | head -n 30)
[ -n "$findings" ] || findings=$(printf '%s\n' "$output" | tail -n 30)
printf 'detekt failed after this edit. Fix these findings:\n%s\n' "$findings" >&2
exit 2
