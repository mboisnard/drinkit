#!/bin/sh
#
# Feeds sample commands to the guard hook and checks which ones it refuses: ./.claude/hooks/guard-github-protections.test

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
hook="$(cd "$(dirname "$0")" && pwd)/guard-github-protections"
failures=0

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export GIT_CEILING_DIRECTORIES="$work" HOME="$work"
hooks_on=$work/on
hooks_off=$work/off
outside=$work/outside
mkdir "$outside" "$work/no-jq" "$work/no-git"
git init -q "$hooks_on" && git -C "$hooks_on" config core.hooksPath .githooks
git init -q "$hooks_off"
for tool in awk cat git; do
    ln -s "$(command -v "$tool")" "$work/no-jq/$tool"
done
for tool in awk cat jq; do
    ln -s "$(command -v "$tool")" "$work/no-git/$tool"
done

run() {
    jq -n --arg command "$1" --arg cwd "$2" '{tool_name: "Bash", cwd: $cwd, tool_input: {command: $command}}' |
        PATH="${3:-$PATH}" "$hook" 2>"$work/stderr"
}

check() {
    expected=$1
    command=$2
    output=$(run "$command" "${3:-$hooks_on}")
    if [ -z "$output" ]; then
        actual=allow
    elif printf '%s' "$output" | jq -e '.hookSpecificOutput.permissionDecision == "deny"' >/dev/null; then
        actual=deny
    else
        actual="invalid output: $output"
    fi
    label=$(printf '%s' "$command" | tr '\n' ' ')
    if [ "$actual" = "$expected" ]; then
        echo "ok    $expected  $label"
    else
        echo "FAIL  expected $expected, got $actual  $label"
        failures=$((failures + 1))
    fi
}

check deny 'gh api --method DELETE repos/mboisnard/drinkit/rulesets/0'
check deny 'gh api -X DELETE repos/mboisnard/drinkit/rulesets/24070575'
check deny 'gh api -X "PATCH" repos/mboisnard/drinkit/rulesets/24070575 -f enforcement=disabled'
check deny 'gh api -X delete repos/mboisnard/drinkit/rulesets/24070575'
check deny 'gh api --method=PUT repos/mboisnard/drinkit/rulesets/24070575 --input .github/rulesets/master.json'
check deny 'gh api repos/mboisnard/drinkit/rulesets/24070575 --input .github/rulesets/master.json'
check deny 'gh api repos/{owner}/{repo}/rulesets -f name=open -f enforcement=disabled'
check deny 'gh api -X PUT repos/mboisnard/drinkit/branches/master/protection --input protection.json'
check deny 'gh api -X DELETE /repos/mboisnard/drinkit/branches/master/protection/enforce_admins'
check deny "gh api graphql -f query='mutation { deleteRepositoryRuleset(input: {repositoryRulesetId: \"x\"}) { clientMutationId } }'"
check deny "gh api graphql -f query='mutation { updateBranchProtectionRule(input: {}) { clientMutationId } }'"
check deny 'gh api repos/mboisnard/drinkit/secret-scanning/push-protection-bypasses -f reason=false_positive -f placeholder_id=x'
# shellcheck disable=SC2016
check deny 'curl -X DELETE -H "Authorization: Bearer $(gh auth token)" https://api.github.com/repos/mboisnard/drinkit/rulesets/1'
check deny 'curl -d @master.json https://api.github.com/repos/mboisnard/drinkit/rulesets'
check deny 'git status && gh api -X PATCH repos/mboisnard/drinkit/rulesets/1 -f enforcement=disabled'
check deny 'cd docs
gh api --method DELETE repos/mboisnard/drinkit/rulesets/1'
check deny 'gh api \
  --method PUT \
  -H "Accept: application/vnd.github+json" \
  /repos/OWNER/REPO/rulesets/RULESET_ID \
  -f "enforcement=disabled"'
check deny 'gh api \
  --method POST \
  /repos/OWNER/REPO/secret-scanning/push-protection-bypasses \
  -f "reason=used_in_tests" -f "placeholder_id=x"'
check deny 'curl -L \
  -X PUT \
  https://api.github.com/repos/OWNER/REPO/rulesets/1 \
  -d @master.json'
check deny 'curl -sSX DELETE https://api.github.com/repos/mboisnard/drinkit/rulesets/1'
check deny 'curl -sSd @body.json https://api.github.com/repos/mboisnard/drinkit/secret-scanning/push-protection-bypasses'
check deny 'curl -d@master.json https://api.github.com/repos/mboisnard/drinkit/rulesets'
check deny 'curl -T master.json https://api.github.com/repos/mboisnard/drinkit/rulesets/1'
check deny 'curl -g -d @master.json https://api.github.com/repos/mboisnard/drinkit/rulesets'
check deny 'gh api repos/mboisnard/drinkit/rulesets -fname=open -fenforcement=disabled'

check allow 'gh api repos/mboisnard/drinkit/rulesets'
check allow "gh api repos/mboisnard/drinkit/rulesets/24070575 --jq '.rules[].type'"
check allow 'gh api -X GET repos/mboisnard/drinkit/rulesets -f per_page=100'
check allow 'gh api repos/mboisnard/drinkit/branches/master/protection'
check allow 'gh api repos/mboisnard/drinkit/secret-scanning/alerts'
check allow 'gh ruleset list'
check allow 'gh ruleset view 24070575'
check allow 'gh api -X POST repos/mboisnard/drinkit/pulls -f title=x -f head=y -f base=master'
check allow "gh api --method PATCH repos/mboisnard/drinkit -f 'security_and_analysis[secret_scanning][status]=enabled'"
check allow 'gh api --method PUT repos/mboisnard/drinkit/private-vulnerability-reporting'
check allow 'git add .github/rulesets/master.json && git commit -F message.txt'
check allow 'gh api repos/mboisnard/drinkit/rulesets --jq length && gh issue comment 1 -F body.md'
check allow 'jq . .github/rulesets/master.json'
check allow 'gh api \
  /repos/OWNER/REPO/rulesets \
  --paginate'
check allow 'curl -sSL https://api.github.com/repos/mboisnard/drinkit/rulesets'
check allow 'curl -sS -D headers.txt https://api.github.com/repos/mboisnard/drinkit/rulesets'
check allow 'curl -G -d per_page=100 https://api.github.com/repos/mboisnard/drinkit/rulesets'

check deny 'gh pr merge 450 --rebase'
check deny 'gh pr merge'
check deny 'env gh pr merge 450'
check deny 'GH_REPO=mboisnard/drinkit gh pr merge 450'
check deny "bash -c 'gh pr merge 450'"
check deny 'gh "pr" merge 450'
check deny 'echo 450 | xargs -n1 gh pr merge'
check deny 'git status && gh pr merge 450 --auto'
check deny 'gh -R mboisnard/drinkit pr merge 450'
check deny 'gh --repo mboisnard/drinkit pr merge 450'
check deny 'gh pr --repo=mboisnard/drinkit merge 450'
check deny '/opt/homebrew/bin/gh pr merge 450'
check deny '\gh pr merge 450'
check deny 'if true; then gh pr merge 450; fi'
# shellcheck disable=SC2016
check deny 'for i in 450; do gh pr merge $i; done'
check deny 'timeout 60 gh pr merge 450'
check deny 'true & gh pr merge 450'
check deny "gh api graphql -f query='mutation { enqueuePullRequest(input: {pullRequestId: \"x\"}) { clientMutationId } }'"
check deny 'gh api --method PUT repos/mboisnard/drinkit/pulls/450/merge'
check deny 'gh api -X PUT repos/{owner}/{repo}/pulls/450/merge -f merge_method=rebase'
check deny 'gh api repos/mboisnard/drinkit/pulls/450/merge -f merge_method=rebase'
# shellcheck disable=SC2016
check deny 'curl -X PUT -H "Authorization: Bearer $(gh auth token)" https://api.github.com/repos/mboisnard/drinkit/pulls/450/merge'
check deny "gh api graphql -f query='mutation { mergePullRequest(input: {pullRequestId: \"x\"}) { clientMutationId } }'"
check deny "gh api graphql -f query='mutation { enablePullRequestAutoMerge(input: {pullRequestId: \"x\"}) { clientMutationId } }'"
check deny 'gh api graphql -F query=@merge.graphql'
check deny 'gh api graphql --input query.json'
check deny "gh alias set land 'pr merge --rebase'"
check deny 'gh alias import aliases.yml'
check deny 'git push --no-verify origin HEAD:master'
check deny 'git push origin 382-implement-issue --no-verify'
check deny 'git -c core.hooksPath=/dev/null push origin HEAD:master'
check deny 'git -C . -c core.hookspath= push'
check deny 'git config --unset core.hooksPath'
check deny 'git config core.hooksPath /dev/null'
check deny 'GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null git push'
check deny 'export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null; git push origin HEAD:master'
check deny "GIT_CONFIG_PARAMETERS=\"'core.hooksPath'='/dev/null'\" git push origin HEAD:master"
check deny 'git push --no-verif origin HEAD:master'
check deny 'git config --global core.hooksPath /dev/null'
check deny 'git config --global --unset core.hooksPath'
check deny 'git config -f .git/config core.hooksPath /dev/null'
check deny 'git config set core.hooksPath /dev/null'
check deny 'git push origin HEAD:master' "$hooks_off"
check deny 'git push origin HEAD:master' "$outside"
check deny 'git -C ../off push -u origin HEAD'
check deny "git -C $hooks_off push -u origin HEAD"
check deny 'git -C .. -C off push -u origin HEAD'
check deny "git --git-dir=$hooks_off/.git push origin HEAD"
check deny 'cd ../off && git push -u origin HEAD'
check deny "cd $hooks_off; git push -u origin HEAD"
check deny 'cd ~/off && git push -u origin HEAD'
check deny 'cd .. && git -C off push -u origin HEAD'
check deny "git push origin HEAD && git -C $hooks_off push origin HEAD"

check allow 'gh pr view 450'
check allow 'gh pr create --base master --title x --body-file body.md'
check allow 'gh pr checks 450 --watch'
check allow 'gh api repos/mboisnard/drinkit/pulls/450/merge'
check allow "gh api graphql -f query='query { viewer { login } }'"
check allow 'gh alias list'
check allow 'git push -u origin HEAD'
check allow 'git push --force-with-lease --force-if-includes'
check allow 'git -C ../on push --force-with-lease origin 382-implement-issue' "$hooks_off"
check allow "git -C $hooks_on push -u origin HEAD" "$outside"
check allow 'cd ../on && git push -u origin HEAD' "$hooks_off"
check allow 'cd ~/on && git push -u origin HEAD' "$outside"
check allow 'cd ../off && cd ../on && git push -u origin HEAD'
check allow 'git config core.hooksPath'
check allow 'git config core.hooksPath .githooks'
check allow 'git config --local core.hooksPath .githooks'
check allow 'git config --get core.hooksPath'
check allow 'git config get core.hooksPath'
check allow 'git config --global core.hooksPath'
check allow 'git config --system core.hooksPath'
check allow 'git config --show-origin core.hooksPath'
check allow 'git config --show-scope --get core.hooksPath'
check allow 'git -C /path/to/worktree config core.hooksPath'
# shellcheck disable=SC2016
check allow 'test "$(git config core.hooksPath)" = .githooks'
# shellcheck disable=SC2016
check allow '[ "$(git config core.hooksPath)" = .githooks ] || echo off'
check allow './gradlew build 2>&1 | tail -n 20'
check allow 'git commit -m "Refuse gh pr merge from agent sessions"'
check allow 'git commit -m "Refuse merges; gh pr merge is for the maintainer"'
check allow 'git commit -m "Never chain git status && gh pr merge 450"'
check allow 'git log --grep "gh pr merge"'
check allow 'grep -rn "core.hooksPath" AGENTS.md'
check allow 'git status' "$hooks_off"
check allow 'git status' "$outside"
check allow 'gh pr merge --help'
check allow 'gh pr merge -h'

check deny 'gh pr merge --help && gh pr merge 450'
check deny 'gh pr merge 450 -h --rebase'
check deny "bash -c 'git status; gh pr merge 450'"
# shellcheck disable=SC2016
check deny 'echo "$(gh pr merge 450)"'
check deny 'gh pr merge 450' "$outside"

check allow "git commit -F - <<'EOF'
Refuse merges from agent sessions

- \`gh pr merge\` stays with the maintainer
- git push --no-verify is refused too
EOF"
# shellcheck disable=SC2016
check allow 'git commit -m "$(cat <<'"'"'EOF'"'"'
Refuse merges from agent sessions

- `gh pr merge` stays with the maintainer; so do rulesets
EOF
)"'
# shellcheck disable=SC2016
check allow 'gh pr create --title x --body "$(cat <<EOF
Never run \`git config core.hooksPath /dev/null\` or gh pr merge
EOF
)"'
check allow "cat >notes.md <<-EOF
	gh pr merge 450
	EOF"
check deny "gh pr merge 450 <<'EOF'
y
EOF"
check deny "cat >notes.md <<'EOF'
merge notes
EOF
gh pr merge 450"
check deny "bash <<'EOF'
gh pr merge 450
EOF"
check deny "cat <<'EOF' | sh
gh pr merge 450
EOF"
# shellcheck disable=SC2016
check allow "cat >notes.md <<'EOF'
\$(gh pr merge 450)
EOF"
check allow "cat >notes.md <<EOF
gh pr merge 450 stays with the maintainer
EOF"
# shellcheck disable=SC2016
check deny 'cat >notes.md <<EOF
$(gh pr merge 450)
EOF'
check deny "cat >notes.md <<EOF
merged: \`gh pr merge 450\`
EOF"
# shellcheck disable=SC2016
check deny 'gh api graphql -f query="$(cat <<EOF
mutation { mergePullRequest(input: {pullRequestId: "x"}) { clientMutationId } }
EOF
)"'

output=$(run 'gh pr merge 450' "$hooks_on" "$work/no-jq")
status=$?
if [ "$status" -eq 0 ] && [ -z "$output" ] && grep -q 'jq not found' "$work/stderr"; then
    echo "ok    allow  without jq, with a warning on stderr"
else
    echo "FAIL  without jq: exit $status, output '$output', stderr '$(cat "$work/stderr")'"
    failures=$((failures + 1))
fi

output=$(jq -n --arg cwd "$hooks_off" '{tool_name: "Bash", cwd: $cwd, tool_input: {command: "git push origin HEAD"}}' |
    PATH="$work/no-git" "$hook")
if [ -z "$output" ]; then
    echo "ok    allow  a push without git installed"
else
    echo "FAIL  a push without git installed was refused: $output"
    failures=$((failures + 1))
fi

if [ "$failures" -ne 0 ]; then
    echo "$failures failing"
    exit 1
fi
