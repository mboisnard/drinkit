#!/bin/sh
#
# Starts sessions in a sample repository and checks what session-context tells Claude: ./.claude/hooks/session-context.test

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
hook="$(cd "$(dirname "$0")" && pwd)/session-context"
failures=0

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
repo=$work/repo
mkdir "$work/outside"
git init -q -b master "$repo"
git -C "$repo" commit -q --allow-empty -m init
git -C "$repo" update-ref refs/remotes/origin/master HEAD

start() {
    output=$(jq -n --arg cwd "${1:-$repo}" '{hook_event_name: "SessionStart", source: "startup", cwd: $cwd}' | "$hook")
    status=$?
}

says() {
    label=$1
    expected=$2
    case $output in
        *"$expected"*) echo "ok    $label" ;;
        *)
            echo "FAIL  $label: expected '$expected' in: $output"
            failures=$((failures + 1))
            ;;
    esac
}

never_says() {
    label=$1
    unexpected=$2
    case $output in
        *"$unexpected"*)
            echo "FAIL  $label: unexpected '$unexpected' in: $output"
            failures=$((failures + 1))
            ;;
        *) echo "ok    $label" ;;
    esac
}

start
says "master points to the issue workflow" "Not on an issue branch"
never_says "a branch level with origin/master says nothing of commits ahead" "ahead"
never_says "a clean tree lists no changes" "Uncommitted"

git -C "$repo" switch -q -c 382-implement-issue
start
says "an issue branch names its issue" "works on issue #382: read it with gh issue view 382."

git -C "$repo" commit -q --allow-empty -m one
git -C "$repo" commit -q --allow-empty -m two
start
says "commits not on master are counted" "2 commits ahead of origin/master."

echo draft >"$repo/notes.md"
start
says "uncommitted work is listed" "?? notes.md"

git -C "$repo" switch -q -c pr-451
start
says "a pull request branch names the pull request" "reviews pull request #451: read it with gh pr view 451."
never_says "a pull request branch is not sent to /implement-issue" "/implement-issue"

git -C "$repo" switch -q --detach HEAD
start
says "a detached HEAD is named" "on a detached HEAD."
says "a detached HEAD is not an issue branch" "Not on an issue branch"

start "$work/outside"
if [ "$status" -eq 0 ] && [ -z "$output" ]; then
    echo "ok    outside a repository nothing is said"
else
    echo "FAIL  outside a repository: exit $status, said: $output"
    failures=$((failures + 1))
fi

if [ "$failures" -ne 0 ]; then
    echo "$failures failing"
    exit 1
fi
