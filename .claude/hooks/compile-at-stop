#!/bin/sh
#
# Claude Code hook on SessionStart and Stop: when a turn changed Kotlin sources, compiles them with their tests and
# hands the errors back to Claude. A state already checked is never checked twice, so it cannot loop

command -v jq >/dev/null 2>&1 || exit 0

input=$(cat)
event=$(printf '%s' "$input" | jq -r '.hook_event_name // empty')
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')
root=$(git -C "${cwd:-.}" rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -x "$root/gradlew" ] || exit 0

checked=$(git -C "$root" rev-parse --path-format=absolute --git-path claude/kotlin-checked) || exit 0
mkdir -p "$(dirname "$checked")"

sources=$(cd "$root" && {
    git ls-files --stage -- '*.kt' '*.kts'
    git diff -- '*.kt' '*.kts'
    git ls-files -z --others --exclude-standard -- '*.kt' '*.kts' | xargs -0 cat
} | cksum)

[ "$(cat "$checked" 2>/dev/null)" = "$sources" ] && exit 0
printf '%s\n' "$sources" >"$checked"
[ "$event" = SessionStart ] && exit 0

output=$(cd "$root" && ./gradlew compileTestKotlin --console=plain 2>&1) && exit 0

errors=$(printf '%s\n' "$output" | grep '^e: ' | head -n 30)
[ -n "$errors" ] || errors=$(printf '%s\n' "$output" | tail -n 30)
jq -n --arg errors "$errors" '{
    decision: "block",
    reason: ("compile-at-stop: the Kotlin code no longer compiles. Fix it before you finish:\n" + $errors)
}'
