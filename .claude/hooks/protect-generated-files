#!/bin/sh
#
# Claude Code PreToolUse hook on Write and Edit: refuses a hand edit of a file that a tool writes, and says which
# command changes it instead

command -v jq >/dev/null 2>&1 || exit 0

file=$(jq -r '.tool_input.file_path // empty')
[ -n "$file" ] || exit 0
dir=$(cd "$(dirname "$file")" 2>/dev/null && pwd -P) || exit 0
root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || exit 0
path=${dir#"$root"}/${file##*/}

case ${path#/} in
    */src/generated/jooq/*)
        how="generated by jOOQ from the schema. Change the changelog, apply it, then run ./gradlew jooqCodegen, as the database-change skill says" ;;
    */src/openapi/*)
        how="generated from the API contract. Change the contract, then run npm run generate:client-api, as the api-contract-change skill says" ;;
    *.lockfile)
        how="written by Gradle. Run the command of the Dependencies section of AGENTS.md" ;;
    package-lock.json | */package-lock.json)
        how="written by npm. Change package.json, then run npm install" ;;
    docs/src/engineering/resources/*)
        how="generated from the code annotations. Change the annotations, then run ./gradlew kspKotlin --rerun" ;;
    .env | .env.* | */.env | */.env.*)
        how="a file of local secrets, which only the maintainer edits" ;;
    *) exit 0 ;;
esac

jq -n --arg reason "protect-generated-files: this file is $how" '{
    hookSpecificOutput: {
        hookEventName: "PreToolUse",
        permissionDecision: "deny",
        permissionDecisionReason: $reason
    }
}'
