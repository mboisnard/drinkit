#!/bin/sh
#
# Plays a session against compile-at-stop with a fake gradlew and checks when it compiles and what Claude is told:
# ./.claude/hooks/compile-at-stop.test

hook="$(cd "$(dirname "$0")" && pwd)/compile-at-stop"
failures=0

repo=$(mktemp -d)
trap 'rm -rf "$repo"' EXIT
git -C "$repo" init -q
mkdir -p "$repo/src"
echo 'class Cellar' >"$repo/src/Cellar.kt"
cat >"$repo/gradlew" <<EOF
#!/bin/sh
echo run >>"$repo/.git/gradle-runs"
if [ -f "$repo/.git/broken" ]; then
    echo "> Task :drinkit-domain:compileKotlin FAILED"
    echo "e: file://$repo/src/Cellar.kt:1:7 Unresolved reference 'Bottle'."
    exit 1
fi
EOF
chmod +x "$repo/gradlew"
git -C "$repo" add . && git -C "$repo" -c user.name=test -c user.email=test@example.com commit -q -m init

send() {
    jq -n --arg event "$1" --arg cwd "$repo" '{hook_event_name: $event, cwd: $cwd, stop_hook_active: false}' | "$hook"
}

check() {
    label=$1
    expected_runs=$2
    expected_block=$3
    actual_runs=0
    [ -f "$repo/.git/gradle-runs" ] && actual_runs=$(grep -c run "$repo/.git/gradle-runs")
    actual_block=no
    printf '%s' "$output" | jq -e '.decision == "block"' >/dev/null 2>&1 && actual_block=yes
    if [ "$actual_runs" -eq "$expected_runs" ] && [ "$actual_block" = "$expected_block" ]; then
        echo "ok    $label"
    else
        echo "FAIL  $label: gradle ran $actual_runs times, blocked: $actual_block"
        failures=$((failures + 1))
    fi
}

output=$(send SessionStart)
check "session start records the sources without compiling" 0 no

output=$(send Stop)
check "a turn without Kotlin changes does not compile" 0 no

echo 'notes' >"$repo/README.md"
output=$(send Stop)
check "a turn that changed only Markdown does not compile" 0 no

echo 'class Cellar(val name: String)' >"$repo/src/Cellar.kt"
output=$(send Stop)
check "a turn that changed Kotlin compiles once" 1 no

touch "$repo/.git/broken"
echo 'class Cellar(val bottle: Bottle)' >"$repo/src/Cellar.kt"
output=$(send Stop)
check "a compile failure blocks the end of the turn" 2 yes
case $output in
    *"Unresolved reference 'Bottle'"*) echo "ok    the compiler error is shown to Claude" ;;
    *)
        echo "FAIL  the compiler error is not shown: $output"
        failures=$((failures + 1))
        ;;
esac

output=$(send Stop)
check "the same state is not checked twice, so it cannot loop" 2 no

echo 'class Bottle' >"$repo/src/Bottle.kt"
output=$(send Stop)
check "a new untracked Kotlin file counts as a change" 3 yes

if [ "$failures" -ne 0 ]; then
    echo "$failures failing"
    exit 1
fi
