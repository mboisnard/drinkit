#!/bin/sh
#
# Feeds file writes to protect-generated-files and checks which ones it refuses: ./.claude/hooks/protect-generated-files.test

export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
hook="$(cd "$(dirname "$0")" && pwd)/protect-generated-files"
failures=0

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
repo=$work/repo
git init -q "$repo"
mkdir -p "$repo/drinkit/drinkit-infra/src/generated/jooq/kotlin/tables" "$repo/deployment/local"

check() {
    expected=$1
    label=$2
    file=$3
    tool=${4:-Edit}
    output=$(jq -n --arg tool "$tool" --arg file "$file" '{tool_name: $tool, tool_input: {file_path: $file}}' | "$hook")
    if [ -z "$output" ]; then
        actual=allow
    elif printf '%s' "$output" | jq -e '.hookSpecificOutput.permissionDecision == "deny"' >/dev/null; then
        actual=deny
    else
        actual="invalid output: $output"
    fi
    if [ "$actual" = "$expected" ]; then
        echo "ok    $expected  $label"
    else
        echo "FAIL  expected $expected, got $actual  $label: $file"
        failures=$((failures + 1))
    fi
}

check deny "a jOOQ class" "$repo/drinkit/drinkit-infra/src/generated/jooq/kotlin/tables/Cellar.kt"
check deny "a jOOQ class written whole" "$repo/drinkit/drinkit-infra/src/generated/jooq/kotlin/tables/Cellar.kt" Write
check deny "a jOOQ class in a package not generated yet" "$repo/drinkit/drinkit-infra/src/generated/jooq/kotlin/bottles/Bottle.kt" Write
check deny "the generated API client, never generated in this clone" "$repo/drinkit/drinkit-frontend/src/openapi/apis/CellarsApi.ts" Write
check deny "a Gradle lock file" "$repo/drinkit/drinkit-backend/gradle.lockfile"
check deny "an npm lock file" "$repo/drinkit/drinkit-frontend/package-lock.json"
check deny "an npm lock file at the root" "$repo/package-lock.json"
check deny "a generated documentation page" "$repo/docs/src/engineering/resources/domains/cellar.md"
check deny "a .env file" "$repo/deployment/local/.env"
check deny "a .env file in a new folder" "$repo/deployment/staging/.env" Write
check deny "a .env variant" "$repo/deployment/local/.env.local"
check deny "a relative path" "drinkit/drinkit-infra/src/generated/jooq/kotlin/tables/Cellar.kt"
check deny "a relative .env at the root" ".env"
check deny "a path with spaces" "$work/my clone/drinkit/drinkit-infra/src/generated/jooq/kotlin/tables/Cellar.kt"
check deny "a .env outside any repository" "$work/outside/.env"

check allow "a Kotlin source" "$repo/drinkit/drinkit-infra/src/main/kotlin/JooqCellars.kt"
check allow "a Vue page" "$repo/drinkit/drinkit-frontend/src/pages/index.vue"
check allow "package.json" "$repo/drinkit/drinkit-frontend/package.json"
check allow "a version catalog" "$repo/gradle/libs.versions.toml"
check allow "the verification metadata" "$repo/gradle/verification-metadata.xml"
check allow "a hand-written documentation page" "$repo/docs/src/engineering/harness.md"
check allow "a .env template" "$repo/deployment/local/.env.example" Write
check allow "a .env sample" "$repo/deployment/local/.env.sample"
check allow "a file outside any repository" "$work/outside/notes.md" Write
check allow "a source path with spaces" "$work/my clone/drinkit/drinkit-infra/src/main/kotlin/Cellar.kt"

if [ "$failures" -ne 0 ]; then
    echo "$failures failing"
    exit 1
fi
